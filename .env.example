# =============================================================
# Instagram comment-to-DM automation — configuration
# Copy to .env and fill in. NEVER commit .env.
# =============================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
# Public HTTPS URL Meta can reach. Localhost works until you need webhooks.
APP_BASE_URL=http://localhost:3000

# ---- Meta app (developers.facebook.com -> your app -> Settings -> Basic) ----
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# Any random string you invent. Paste the SAME value into Meta's webhook form.
META_WEBHOOK_VERIFY_TOKEN=

# ---- Your Instagram account ----
# Instagram Business/Creator account ID (not the @handle)
INSTAGRAM_ACCOUNT_ID=
# The Facebook Page linked to that Instagram account
FACEBOOK_PAGE_ID=

# Long-lived Page token, or a System User token that never expires.
# Needs: instagram_basic, instagram_manage_comments, instagram_manage_messages,
#        pages_show_list, pages_read_engagement, pages_manage_metadata
META_ACCESS_TOKEN=

# ---- Your brand (shown in the dashboard and in seeded example wording) ----
BRAND_NAME=My Channel
# Your @handle, without the @
INSTAGRAM_HANDLE=your_handle

# ---- Safeguards ----
# Milliseconds between outbound API calls, to stay under Meta's burst limits.
API_REQUEST_DELAY_MS=1500
# Retries for transient/rate-limit failures. A refusal is never retried.
MAX_RETRIES=3
# How many times one comment may be re-attempted after a retryable failure.
MAX_COMMENT_ATTEMPTS=3
# true = kill switch, blocks every outbound message.
EMERGENCY_STOP=false

# ---- Optional ----
# Appended to outbound messages. Leave empty to append nothing.
DISCLAIMER_TEXT=
